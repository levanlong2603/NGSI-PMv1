[Unit]
Description=NGSI PM - Quan tri cong viec va nguon luc (Phong Quan ly du an)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=ngsi
Group=ngsi
WorkingDirectory=/opt/ngsi
EnvironmentFile=/opt/ngsi/.env
ExecStart=/usr/bin/node /opt/ngsi/backend/server.js
Restart=always
RestartSec=3
# Bảo mật
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ngsi

[Install]
WantedBy=multi-user.target
